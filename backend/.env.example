#.env.example
# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/smart_irrigation_db

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Weather API
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# AI API Configuration (choose one)
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Cohere (alternative)
COHERE_API_KEY=your_cohere_api_key_here

# Gemini (alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# SMS Configuration
# Africa's Talking
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_USERNAME=your_africas_talking_username

# Twilio (fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SendGrid (alternative)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Settings
APP_NAME=Smart Irrigation Assistant
APP_VERSION=1.0.0
DEBUG=True
CORS_ORIGINS="https://smart-agri-five.vercel.app"

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Scheduler Settings
SCHEDULER_TIMEZONE=Africa/Kigali
